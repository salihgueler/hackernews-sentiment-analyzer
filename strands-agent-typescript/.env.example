# AWS credentials for Amazon Bedrock (Claude Haiku 4.5)
# Use one of these authentication methods:

# Option 1: Standard AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Option 2: Bedrock bearer token
# AWS_BEARER_TOKEN_BEDROCK=

# AWS region that has Claude Haiku 4.5 enabled
AWS_REGION=us-east-1
