# Copy this file to .env and fill in your values.

# Required: OpenAI API key for sentiment analysis and report synthesis.
OPENAI_API_KEY=sk-...

# Optional: override the model used for sentiment analysis.
# Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini

# Optional: override the base URL (e.g. for Azure OpenAI, OpenRouter, local LLMs).
# OPENAI_BASE_URL=https://api.openai.com/v1
