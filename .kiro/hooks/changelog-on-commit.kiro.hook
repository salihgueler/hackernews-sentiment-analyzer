{
  "enabled": true,
  "name": "Update Changelog After Commit",
  "description": "Automatically adds a meaningful entry to CHANGELOG.md after every commit by reviewing the latest commit message and changed files.",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "shell"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Look at the shell command that just ran. ONLY proceed if the command starts with 'git commit'. If it does NOT start with 'git commit', do absolutely nothing and stop. If it IS a git commit command, then: 1) Run `git log -1 --pretty=format:\"%s\"` to get the commit message, 2) Run `git diff-tree --no-commit-id --name-only -r HEAD` to get changed files, 3) Add a new entry to CHANGELOG.md under today's date in the format: `- <commit summary>: <brief description of what changed based on the files>`."
  }
}